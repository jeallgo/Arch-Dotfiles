* {
    bg-window:      {{colors.surface.default.hex}}; 
    bg-input:       {{colors.on_surface.default.hex}};
    foreground:     {{colors.on_background.default.hex}};
    selected:       {{colors.primary.default.hex}};
    active:         {{colors.tertiary.default.hex}};
    urgent:         {{colors.error.default.hex}};
    text-normal:    {{colors.on_surface.default.hex}};
    text-selected:  {{colors.on_primary.default.hex}};

    bg-window-alpha: {{colors.surface.default.hex}}; 

    bg-input-alpha:  {{colors.on_surface.default.hex}}1F; 
    selected-alpha:  {{colors.primary.default.hex}}26;  
    text-muted:      {{colors.on_surface.default.hex}}4D;
}
