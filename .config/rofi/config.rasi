configuration {
    modi: "drun";
    font: "Rubik 10";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "";
    drun-display-format: "{name}";
    disable-history: false;
    hide-scrollbar: true;
    sidebar-mode: false;
    terminal: "kitty";
}

@import "colors.rasi"

* {
    bg: @bg-window-alpha;
    input-bg: @bg-input-alpha;
    fg: @text-normal;
    button: @bg-input-alpha;

    background-color: transparent;
    text-color: @fg;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 620px;
    border: 0;
    border-radius: 12px;
    background-color: @bg;
    padding: 24px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 20px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @input-bg;
    text-color: @fg;
    expand: false;
    border-radius: 8px;
    padding: 12px 16px;
}

prompt {
    enabled: false;
}

entry {
    placeholder: "Search";
    placeholder-color: @text-muted;
    background-color: transparent;
    text-color: @fg;
    expand: true;
    horizontal-align: 0.0;
    cursor: text;
}

listview {
    columns: 4;
    lines: 3;
    cycle: true;
    dynamic: true;
    layout: vertical;
    spacing: 14px;
    background-color: transparent;
    fixed-height: true;
    fixed-columns: true;
}

element {
    orientation: vertical;
    border-radius: 10px;
    padding: 16px 10px;
    spacing: 10px;
    background-color: transparent;
    cursor: pointer;
}

element-icon {
    size: 40px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    cursor: inherit;
}

element-text {
    expand: true;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    highlight: none;
    cursor: inherit;
}

element selected {
    background-color: @selected-alpha;
    text-color: inherit;
    border-radius: 10px;
}
